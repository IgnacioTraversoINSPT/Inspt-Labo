Algoritmo TP3ej05
	Definir n1,n2 Como Real
	Escribir "ingresa un numero"
	leer n1
	Escribir "ingresa otro numero"
	leer n2
	Si n1 > n2 Entonces
		Escribir n1, " es mayor a: ", n2
	SiNo
		Si n1 < n2 Entonces
			Escribir n1, " es menor a: ", n2
		SiNo
			Escribir "son iguales"
		Fin Si
	Fin Si
FinAlgoritmo


